# Скопировать в .env рядом с этим файлом, права только владельцу.
# .env никогда не попадает в репозиторий, в логи и в переписку.

TELEGRAM_BOT_TOKEN=
OWNER_USER_ID=

# llama.cpp — рекомендация по умолчанию: один процесс без постоянного
# фонового демона, им проще управлять из режимов IDLE/ACTIVE/BATCH (Э8)
# на машине с малым запасом свободной RAM. Ollama — рабочая альтернатива,
# меняется одной строкой (тогда порт обычно 11434).
LLM_BACKEND=llama.cpp
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=gemma-3-4b-it-Q4_K_M

EXPORT_DIR=C:\Users\Huawei\Downloads\Telegram Desktop\JDG

# Диск C: заполнен на ~92%, а дерево архива удваивает объём копиями
# (или не удваивает, если перейдём на hardlink — см. план Э2).
# Указать папку на томе с реальным запасом места.
ARCHIVE_DIR=

KSEF_ENABLED=false
