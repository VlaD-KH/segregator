{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdvisoryReport",
  "type": "object",
  "required": ["scenarios","assumptions","unknowns","note","disclaimer"],
  "properties": {
    "scenarios": {
      "type": "array","minItems": 2,
      "items": {
        "type": "object",
        "required": ["name","figures","tradeoff"],
        "properties": {
          "name": {"type": "string"},
          "figures": {"type": "object","additionalProperties": {"type": "number"}},
          "effective_burden_pct": {"type": ["number","null"]},
          "tradeoff": {"type": "string","description": "чем этот вариант хуже, а не только чем лучше"}
        }
      }
    },
    "assumptions": {"type": "array","minItems": 1,"items": {"type": "string"}},
    "unknowns": {"type": "array","items": {"type": "string"}},
    "note": {"type": "string","maxLength": 900},
    "disclaimer": {"type": "string","description": "обязательное поле: расчёт, а не налоговая консультация"}
  },
  "additionalProperties": false
}
